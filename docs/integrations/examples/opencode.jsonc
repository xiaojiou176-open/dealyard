{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dealwatcherer": {
      "type": "local",
      "enabled": true,
      "command": ["uv", "run", "python", "-m", "dealwatcherer.mcp", "serve", "--transport", "stdio"],
      "environment": {
        "PYTHONPATH": "src"
      }
    }
  }
}
